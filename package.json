{
  "name": "@godchaser/scope",
  "version": "0.2.3",
  "author": {
    "name": "godchaser",
    "url": "https://github.com/securityCFS"
  },
  "description": "SCOPE: One monitor for all agent sessions — unified web workbench for coding agents across local and SSH GPU hosts",
  "homepage": "https://securitycfs.github.io/SCOPE/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/securityCFS/SCOPE.git"
  },
  "bugs": {
    "url": "https://github.com/securityCFS/SCOPE/issues"
  },
  "bin": {
    "scope": "./bin/scope.mjs",
    "scope-workbench": "./bin/scope.mjs"
  },
  "files": [
    "bin/",
    "bridge/",
    "dist/",
    "examples/",
    "lib/",
    "scripts/",
    "!**/__pycache__/**",
    "!**/*.pyc",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "README.zh-CN.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai-agents",
    "codex",
    "claude-code",
    "antigravity",
    "agent-monitor",
    "ssh",
    "gpu-cluster",
    "tmux",
    "developer-tools"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "plugin": "node scripts/plugin-cli.mjs",
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "bridge": "node bridge/server.mjs",
    "scope": "node bridge/start.mjs",
    "scope:dev": "node bridge/start.mjs --dev",
    "private-gateway": "node bridge/private-start.mjs",
    "shared-gateway": "node bridge/shared-start.mjs",
    "email:status": "node scripts/email-notification-cli.mjs status",
    "email:verify": "node scripts/email-notification-cli.mjs verify",
    "email:test": "node scripts/email-notification-cli.mjs test",
    "email:agent-relay": "node scripts/agent-email-relay.mjs",
    "remote:bootstrap": "node scripts/remote-bootstrap-cli.mjs",
    "export:opensource": "node scripts/export-opensource.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "check": "npm run typecheck && npm run build && npm run test:unit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "prepack": "npm run build",
    "preview:fixture": "node scripts/preview-workbench.mjs"
  },
  "dependencies": {
    "nodemailer": "^9.0.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "^26.1.0",
    "katex": "^0.18.1",
    "lucide-react": "^1.25.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "react-server-dom-webpack": "19.2.6",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
